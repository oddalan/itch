config_version=5

[application]

config/name="Under my Bed"
run/main_scene="uid://drfajkep54hwc"
config/features=PackedStringArray("4.7", "Forward Plus")
run/max_fps=60
boot_splash/bg_color=Color(0.13333334, 0.15294118, 0.23921569, 1)
boot_splash/image="uid://der2r666we1j3"
config/icon="uid://covo2ols81rty"

[autoload]

GlobalAudio="*uid://o3x5q31g57k"

[display]

