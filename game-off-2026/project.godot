; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Game-Off 2026"
run/main_scene="uid://doc36rwtk3fbk"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

DialogueManager="*uid://c3rodes2l3gxb"

[dialogue_manager]

runtime/balloon_path="res://Dialogue/Balloon/balloon.tscn"

[display]

window/size/viewport_width=320
window/size/viewport_height=180
window/stretch/mode="viewport"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogue_manager/plugin.cfg", "res://addons/dualgrid/plugin.cfg")

[file_customization]

folder_colors={
"res://Dialogue/": "green",
"res://Home Screen/No AI/": "red",
"res://addons/": "orange"
}

[internationalization]

locale/translations_pot_files=PackedStringArray("res://Gameplay/Scene/Levels/1/Cutscene/dialogue_file.dialogue")

[physics]

3d/physics_engine="Jolt Physics"
2d/default_gravity=490.0

[rendering]

textures/canvas_textures/default_texture_filter=0
textures/canvas_textures/default_texture_repeat=1
rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.19607843, 0.19215687, 0.23137255, 1)
2d/snap/snap_2d_transforms_to_pixel=true
